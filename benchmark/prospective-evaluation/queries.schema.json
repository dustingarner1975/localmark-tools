{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LocalMark frozen prospective queries",
  "type": "object",
  "required": [
    "version",
    "frozen_at",
    "queries"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string"
    },
    "authorship": {
      "type": "string"
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "query",
          "requirements"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "checked_within_hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168
              },
              "a2a_response_within_hours": {
                "type": "integer",
                "minimum": 1,
                "maximum": 168
              },
              "tls_reachable": {
                "type": "boolean"
              },
              "auth": {
                "enum": [
                  "none",
                  "declared"
                ]
              },
              "signature": {
                "const": "verified"
              },
              "protocol": {
                "enum": [
                  "JSONRPC",
                  "HTTP+JSON",
                  "GRPC"
                ]
              },
              "network": {
                "type": "string",
                "minLength": 1
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "max_amount": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]+)?$"
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
